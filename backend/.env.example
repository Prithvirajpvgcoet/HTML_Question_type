# Backend .env example — copy to .env and fill in real values
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/dbname
DATABASE_URL_SYNC=postgresql://user:pass@localhost:5432/dbname
GEMINI_API_KEY=your-gemini-api-key-here
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ENVIRONMENT=development

# Optional overrides (these have defaults)
# LLM_MODEL_GENERATION=gemini-3.1-flash-lite
# LLM_MODEL_SCORING=gemini-3.1-flash-lite
# LLM_RPM_LIMIT=10
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=0.2
# SANDBOX_POOL_SIZE=4
# EVAL_TIMEOUT_MS=30000
